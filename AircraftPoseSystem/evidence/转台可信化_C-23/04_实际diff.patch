+#pragma once
+
+// ============================================================================
+//  src/data/TurntableSample.h
+//
+//  依据：SYS-10 §6.4（样本采集与到位判据）、§13（状态）、
+//        评审 C2/C4（2026-10-19）、裁决 C-23
+//
+//  作用：一次轮询周期产出的**两轴同轮**样本。
+//
+//  ⚠ 为什么不能继续只发布两个角度原子量：
+//    `azimuth_` 与 `elevation_` 各自更新时，一次丢包会让“新的方位角”
+//    与“上一周期的俯仰角”同时出现在快照里。两个值都合法、都有限，
+//    但**不属于同一时刻** —— 由它们算出的到位判据、或写入结果包的
+//    转台状态，都是拼接出来的事实。本结构体用 cycleId + 采样时刻 +
+//    valid 把“同一轮、同一时刻”变成可检查的不变量。
+//
+//  ⚠ valid=false 时 azimuth/elevation **没有意义**，不得被上层使用。
+//    这不是“值为 0”，而是“本轮没有可信读数”。
+// ============================================================================
+
+#include <cstdint>
+
+namespace aircraft
+{
+namespace data
+{
+
+/// 样本来源，便于结果包与日志区分“设备读数”与“本地默认值”。
+enum class TurntableSampleSource : std::uint8_t
+{
+    None = 0,  ///< 尚无样本
+    Poll = 1,  ///< 一次轮询周期内同时取得的两轴角
+};
+
+/// 同一轮询周期内同时取得的两轴角。
+struct TurntableSample
+{
+    /// 方位角，单位 deg（ENG-09 §2.2）。
+    double azimuth = 0.0;
+
+    /// 俯仰角，单位 deg。
+    double elevation = 0.0;
+
+    /// 本轮样本的取得时刻，ns，CLOCK_MONOTONIC。
+    /// 这是**主机侧完成两轴解析的时刻**，不是设备的曝光/采样时刻。
+    std::uint64_t sampleTimestampNs = 0;
+
+    /// 单调递增的轮询周期编号（从 1 开始）。两轴共享同一个编号。
+    std::uint64_t cycleId = 0;
+
+    /// 两轴是否都取得了地址正确、数值合法的回复。
+    /// 任一轴缺失/非法/地址错 ⇒ false，且本轮的角值不得发布。
+    bool valid = false;
+
+    TurntableSampleSource source = TurntableSampleSource::None;
+};
+
+}  // namespace data
+}  // namespace aircraft
--- /dev/null	2026-09-22 16:01:10.800486225 +0800
+++ AircraftPoseSystem/src/device/turntable/ITurntableDiagnostics.h	2026-10-19 21:33:56.176897192 +0800
@@ -0,0 +1,35 @@
+#pragma once
+
+// ============================================================================
+//  src/device/turntable/ITurntableDiagnostics.h
+//
+//  依据：裁决 C-23（2026-10-19）
+//
+//  作用：与冻结的 `ITurntableController` **并列**的诊断接口。
+//
+//  ⚠ 为什么不给 `ITurntableController` 增加 `lastError()`/`diagnostics()`：
+//    该接口的方法面在 SYS-06 中冻结（`initialize()/move()/state()/stop()`）。
+//    诊断是“可信化”新引入的能力，用并列接口承载，生产者（真实后端）
+//    实现它，消费者（装配点、测量总控）按可选指针接收 —— 虚拟后端、
+//    测试桩都不必被迫实现。这样既不破坏冻结签名，也不让“没有诊断能力”
+//    看起来像“没有故障”。
+// ============================================================================
+
+#include "data/TurntableDiagnostics.h"
+
+namespace aircraft
+{
+namespace device
+{
+
+class ITurntableDiagnostics
+{
+public:
+    virtual ~ITurntableDiagnostics() = default;
+
+    /// 取一致快照。实现方**不得**在此做 I/O 或等待 I/O 锁。
+    virtual data::TurntableDiagnostics diagnostics() const = 0;
+};
+
+}  // namespace device
+}  // namespace aircraft
--- /dev/null	2026-09-22 16:01:10.800486225 +0800
+++ AircraftPoseSystem/tests/run_tests.sh	2026-10-19 22:00:15.646914512 +0800
@@ -0,0 +1,67 @@
+#!/usr/bin/env bash
+# ============================================================================
+#  tests/run_tests.sh
+#
+#  仓库内的**原生测试入口**（C-23 / A5）：配置 → 构建 → CTest。
+#
+#  与 `/tmp/gtshim/build_tests.sh` 的关系：
+#    · 本脚本是首选路径，要求真实 GoogleTest；
+#    · 缺少 GoogleTest 时**明确失败并给出安装提示**，不得静默跳过 ——
+#      静默跳过会产出一个"0 failed"的空结果，比失败更危险；
+#    · `/tmp/gtshim` 仅作为离线回退（垫片不是 GTest，见其文件头）。
+#
+#  ⚠ 为什么不在脚本里按文件名通配汇总二进制：`/tmp/gtshim` 历史上堆着
+#    故意带红的变异件，通配会把它们算进"通过"。CTest 只执行**本次配置
+#    注册**的目标，不存在这个风险；本脚本用它作为唯一执行器。
+#
+#  用法：
+#      bash tests/run_tests.sh              # build_tests/ 下配置并全量运行
+#      BUILD_DIR=/tmp/aps-build bash tests/run_tests.sh
+#      APS_HAVE_IMVSDK=1 bash tests/run_tests.sh   # 需要 SDK 变体时
+# ============================================================================
+set -euo pipefail
+
+ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
+BUILD_DIR="${BUILD_DIR:-$ROOT/build_tests}"
+SDK="${APS_HAVE_IMVSDK:-0}"
+JOBS="${JOBS:-$(nproc 2>/dev/null || echo 4)}"
+
+echo "[run_tests] 源码目录：$ROOT"
+echo "[run_tests] 构建目录：$BUILD_DIR（APS_HAVE_IMVSDK=$SDK）"
+
+cmake -S "$ROOT" -B "$BUILD_DIR" \
+    -DBUILD_TESTING=ON \
+    -DAPS_HAVE_IMVSDK="$SDK"
+
+# ---- GoogleTest 检测 -------------------------------------------------------
+# tests/CMakeLists.txt 在缺 GTest 时直接 return()，**不会** add_subdirectory
+# 任何测试子目录。故判据是"tests/ 下存在第二层 CTestTestfile.cmake"，
+# 而不是"存在任何一个 CTestTestfile"——顶层安装自检
+# （install_check / install_launch_check）与 GTest 无关，永远会生成
+# build/tests/CTestTestfile.cmake，不能拿来当测试已启用的证据。
+if ! find "$BUILD_DIR/tests" -mindepth 2 -name CTestTestfile.cmake \
+        -print -quit 2>/dev/null | grep -q .; then
+    cat >&2 <<'EOF'
+
+[run_tests] 错误：未找到 GoogleTest，测试目标没有被生成。
+
+  这与"测试全部通过"是两件事：本脚本拒绝在缺少测试的情况下返回 0。
+  安装（Ubuntu / UOS 系）：
+      sudo apt install libgtest-dev cmake
+  或从源码构建后安装到 /usr/local。
+  安装完成后重新执行本脚本（无需清理构建目录）。
+
+  离线回退：bash /tmp/gtshim/build_tests.sh（垫片，不是真实 GTest）。
+EOF
+    exit 1
+fi
+
+cmake --build "$BUILD_DIR" -j"$JOBS"
+
+# 只跑 aps_add_test 注册的 `test_*`。install_check / install_launch_check
+# 是安装包自检（依赖本机部署环境），不属于本脚本的"测试通过"判据；
+# 混进来会让"没装相机"看起来像"测试失败"。
+echo "[run_tests] 执行 CTest（test_* 目标）"
+ctest --test-dir "$BUILD_DIR" -R "^test_" --output-on-failure --no-tests=error
+
+echo "[run_tests] 全部已注册测试通过"
