+/// 读取一行；EOF 返回 false。超时（timeoutMs）返回 true 但 line 为空。
+bool readLineWithTimeout(int timeoutMs, std::string& line, bool& eof)
+{
+    eof = false;
+    fd_set set;
+    FD_ZERO(&set);
+    FD_SET(STDIN_FILENO, &set);
+    timeval tv;
+    tv.tv_sec  = timeoutMs / 1000;
+    tv.tv_usec = (timeoutMs % 1000) * 1000;
+    const int ready = select(STDIN_FILENO + 1, &set, nullptr, nullptr, &tv);
+    if (ready < 0)
+    {
+        // 信号中断不是 EOF：主循环据此走“请求停止 → 正常退出”路径，
+        // 而不是把 SIGINT 当成输入结束。
+        if (errno == EINTR)
+        {
+            line.clear();
+            return true;
+        }
+        eof = true;
+        return false;
+    }
+    if (ready == 0)
+    {
+        line.clear();
+        return true;  // timeout
+    }
+
+    line.clear();
+    char c = 0;
+    while (true)
+    {
+        const ssize_t n = ::read(STDIN_FILENO, &c, 1);
+        if (n <= 0)
+        {
+            eof = true;
+            return false;
+        }
+        if (c == '\n')
+        {
+            break;
+        }
+        line.push_back(c);
+    }
+    return true;
+}
