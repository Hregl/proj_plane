-        Ok,
-        InvalidArgument, ContractViolation, NotImplemented,   // **判定类别**属本地
-                                                              // ⚠ **不等于**"未调用过 SDK"，见下
-        Timeout, NoFrame, NotStarted, Disconnected,           // 设备／取帧状态
-        CorruptFrame,     // **SDK 调用成功，但帧不满足可交付条件**（不得归为 Timeout）
-        SdkError          // 已调用 SDK，且按有依据的语义无法归类（原码保留）
