+    {
+        std::string protocol;         // "sdk" | "pelco_d_udp" | "rs485" | "network"
+        double      azimuthMin;       // deg
+        double      azimuthMax;       // deg
+        double      elevationMin;     // deg
+        double      elevationMax;     // deg
