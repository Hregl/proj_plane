+double azDelta(double a, double b)
+{
+    // [0, 180]，与生产判据一致。
+    double d = std::fabs(a - b);
+    while (d > 360.0)
+    {
+        d -= 360.0;
+    }
+    if (d > 180.0)
+    {
+        d = 360.0 - d;
+    }
+    return d;
+}
