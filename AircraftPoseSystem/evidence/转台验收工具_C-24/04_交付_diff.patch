+    struct MeasurementConfig
+    {
+        // 评分权重：Score = w1*Q + w2*F + w3*M - w4*E
+        double w1;
+        double w2;
+        double w3;
+        double w4;
+
+        double minSharpness;         // 图像质量下限
+        double minTargetPixelSize;   // 目标像素尺寸下限
+        int    minFeatureCount;
+        double minMatchRatio;
+
